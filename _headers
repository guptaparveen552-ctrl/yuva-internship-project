# Sample caching strategy (Netlify/Cloudflare Pages _headers format), carried
# over from the Week 4 performance work. Hashed filenames are safe to cache
# for a year — a future edit gets a new hash and therefore a new URL, so
# browsers never serve stale CSS or JS. index.html and data.json are the
# two files that must always be revalidated, since data.json is the one
# thing on this page that's expected to actually change over time.

/index.html
  Cache-Control: no-cache

/data.json
  Cache-Control: no-cache

/styles.min.*.css
  Cache-Control: public, max-age=31536000, immutable

/script.min.*.js
  Cache-Control: public, max-age=31536000, immutable
